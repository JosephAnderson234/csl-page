---
const photos = [
	{ src: "/images/events/claude-day-aula.jpg", alt: "Aula Magna llena durante el Claude Day" },
	{ src: "/images/events/java-grupal.jpg", alt: "Foto grupal de los asistentes a la charla de Java" },
	{ src: "/images/events/game-jam-apertura.jpg", alt: "Premiación de la Takernal Game Jam 2026" },
	{ src: "/images/events/claude-day-equipo.jpg", alt: "Equipo organizador del Claude Day" },
];
---

<section class="events">
	<div class="events__info">
		<h2 class="events__title">Eventos para aprender juntos.</h2>
		<p class="events__text">
			Solo en 2026 hicimos más de 20 actividades, del FLISoL UTEC al Claude Day.
			Son espacios para aprender, conocer gente y compartir tus proyectos.
		</p>

		<div class="events__footer">
			<img class="events__penguin" src="/images/penguins/events.svg" alt="" />
			<a href="/events" class="events__button">
				Ver Eventos
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6" />
				</svg>
			</a>
		</div>
	</div>

	<div class="events__gallery">
		{photos.map((photo) => (
			<img class="events__photo" src={photo.src} alt={photo.alt} loading="lazy" />
		))}
	</div>
</section>
