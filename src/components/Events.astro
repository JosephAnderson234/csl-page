---
// TODO: reemplazar por fotos reales de los eventos
const photos = [
	{ src: "/images/placeholder.svg", alt: "Imagen referencial de un taller" },
	{ src: "/images/placeholder.svg", alt: "Imagen referencial de la comunidad" },
	{ src: "/images/placeholder.svg", alt: "Imagen referencial de una charla" },
	{ src: "/images/placeholder.svg", alt: "Imagen referencial de miembros programando" },
];
---

<section class="events">
	<div class="events__info">
		<h2 class="events__title">Imagina que hay un título piola para la sección de eventos.</h2>
		<p class="events__text">
			En CSL, consideramos que los eventos son esenciales para el desarrollo y
			crecimiento de cada miembro de la comunidad.
		</p>
		<p class="events__text">
			Por ello, organizamos talleres, charlas, meetups, y festivales, creando
			espacios donde puedes aprender, conocer a nuevas personas, y desarrollar o
			compatir tus propios proyectos.
		</p>

		<div class="events__footer">
			<img class="events__penguin" src="/images/penguins/events.svg" alt="" />
			<a href="/events" class="events__button">
				Ver Eventos
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6" />
				</svg>
			</a>
		</div>
	</div>

	<div class="events__gallery">
		{photos.map((photo) => (
			<img class="events__photo" src={photo.src} alt={photo.alt} loading="lazy" />
		))}
	</div>
</section>
